# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/

# ---- SDD 工作区（每个计划自己的目录，git-ignored scratch）----
.superpowers/

# ---- 构建产物 ----
dist/
*.zip

# ---- Blender 场景文件 ----
*.blend
*.blend1

# ---- 截图与派生图像（dev/out 全部是临时产物，不入库）----
dev/out/
crop_*.png
# capture_shots.py 的整窗原图中间产物（约 1.8MB/张），裁切后的 <state>.png 才入库
ui_workbench/data/shots/*_full.png

# ---- 临时诊断与验证碎片 ----
dev/_tmp_verify/
_pipe_renders/
dev/_junklist.txt

# ---- 密钥与本地环境（**绝不入库**）----
.env
.env.*
*.env
!.env.example
# 本机 Blender / API 凭据
*.key
*.pem
userpref.blend

# ---- 宣传片制作（promo/）：原始录屏、配音、中间产物与成片（>200MB），不入库 ----
